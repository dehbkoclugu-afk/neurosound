{
  "expo": {
    "name": "NeuroSound",
    "slug": "neurosound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "neurosound",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neurosound.app",
      "infoPlist": {
        "_localizationsNote": "Without CFBundleLocalizations iOS reports the app as English-only: the App Store listing shows no other languages and the system picks en for a device set to, say, Japanese even though ja.json exists. Keep in sync with locales/index.ts.",
        "CFBundleLocalizations": [
          "tr",
          "en",
          "de",
          "es",
          "fr",
          "it",
          "ja",
          "ko",
          "pt",
          "ru",
          "zh-Hans",
          "hi",
          "bn",
          "id",
          "vi",
          "th",
          "pl",
          "uk",
          "nl",
          "sv",
          "ro"
        ],
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.neurosound.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#15130F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F2E7",
          "dark": {
            "backgroundColor": "#15130F"
          }
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-localization",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce1b68e4-bf78-477b-bbeb-cfc41a1640ed"
      }
    }
  }
}
