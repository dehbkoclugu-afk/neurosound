{
  "expo": {
    "name": "852Hz",
    "slug": "neurosound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "neurosound",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dehbkoclugu.neurosound",
      "infoPlist": {
        "_localizationsNote": "Without CFBundleLocalizations iOS reports the app as English-only: the App Store listing shows no other languages and the system picks en for a device set to, say, Japanese even though ja.json exists. Keep in sync with locales/index.ts.",
        "CFBundleLocalizations": [
          "tr",
          "en",
          "de",
          "es",
          "fr",
          "it",
          "ja",
          "ko",
          "pt",
          "ru",
          "zh-Hans",
          "hi",
          "bn",
          "id",
          "vi",
          "th",
          "pl",
          "uk",
          "nl",
          "sv",
          "ro"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.dehbkoclugu.neurosound",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#15130F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F2E7",
          "dark": {
            "backgroundColor": "#15130F"
          }
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": "852Hz never records audio and never asks for the microphone. This text exists only because the audio library includes recording code.",
          "_microphoneNote": "iOS only: with false, App Store Connect can reject the upload (ITMS-90683) because expo-audio links recording APIs. The permission is never requested; Android stays blocked via recordAudioAndroid and blockedPermissions."
        }
      ],
      "expo-asset",
      "expo-localization",
      "expo-font",
      "./plugins/withoutMicrophoneService",
      "expo-quick-actions",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Ember",
            "ios": "./assets/images/alt-icons/ember.png",
            "android": {
              "foregroundImage": "./assets/images/alt-icons/ember-foreground.png",
              "backgroundColor": "#101418"
            }
          },
          {
            "name": "Paper",
            "ios": "./assets/images/alt-icons/paper.png",
            "android": {
              "foregroundImage": "./assets/images/alt-icons/paper-foreground.png",
              "backgroundColor": "#F0EDEA"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce1b68e4-bf78-477b-bbeb-cfc41a1640ed"
      }
    }
  }
}
